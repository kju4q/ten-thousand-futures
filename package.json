{
  "name": "ten-thousand-futures",
  "private": true,
  "version": "1.8.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "check:text": "node scripts/check-no-em-dash.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run check:text && npm run typecheck && npm run lint && npm run test && npm run build && npm run check:text && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource-variable/space-grotesk": "^5.2.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.42.0",
    "vite": "6.1.0",
    "vitest": "^3.2.4"
  }
}
